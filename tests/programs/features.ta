செயலி ஃபிபொ(n: முழுஎண்) -> முழுஎண்:
    என்றால் n <= 1:
        திருப்பு n
    திருப்பு ஃபிபொ(n - 1) + ஃபிபொ(n - 2)

செயலி முதன்மை():
    அச்சிடு("fib:", ஃபிபொ(10))

    மாறி pi: மிதவை = 3.14159
    அச்சிடு("pi =", pi)

    மாறி r2 = கணிதம்.வர்க்கமூலம்(16.0)
    அச்சிடு("sqrt16 =", r2)
    அச்சிடு("floor 3.9 =", கணிதம்.முழுமதிப்பு(3.9))
    அச்சிடு("2^10 =", கணிதம்.சக்தி(2, 10))
    அச்சிடு("abs -7 =", கணிதம்.தனிமதிப்பு(-7))

    மாறி எண்கள் = [10, 20, 30]
    அச்சிடு("list0 =", எண்கள்[0])
    எண்கள்[1] = 99
    அச்சிடு("list1 =", எண்கள்[1])
    அச்சிடு("len list =", நீளம்(எண்கள்))

    மாறி கூட்டல் = 0
    ஒவ்வொன்றும் v இல் எண்கள்:
        கூட்டல் += v
    அச்சிடு("sum =", கூட்டல்)

    மாறி நபர் = {"பெயர்": "புடின்", "ஊர்": "சென்னை"}
    அச்சிடு("name =", நபர்["பெயர்"])
    அச்சிடு("city =", நபர்["ஊர்"])
    நபர்["பெயர்"] = "மீனா"
    அச்சிடு("new name =", நபர்["பெயர்"])
    மாறி வயதுகள் = {"புடின்": 23, "மீனா": 21}
    அச்சிடு("int-dict =", வயதுகள்["மீனா"])

    மாறி உரை1 = "Tamizhi"
    அச்சிடு("len str =", நீளம்(உரை1))
    ஒவ்வொன்றும் எ இல் உரை1:
        அச்சிடு(எ)
    அச்சிடு("char[0] =", உரை1[0])
    அச்சிடு("eq:", "abc" == "abc", "neq:", "x" != "y")

    ஒவ்வொன்றும் i இல் வரம்பு(5):
        என்றால் i == 3:
            நிறுத்து
        அச்சிடு("i =", i)

    மாறி c: எழுத்து = 'ழ'
    அச்சிடு("char:", c)
    பூலியன்_சோதனை = உண்மை
    அச்சிடு(பூலியன்_சோதனை, இல்லை பூலியன்_சோதனை)
