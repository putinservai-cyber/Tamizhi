செயலி சோதனை():
    மாறி s = "x"
    ஒவ்வொன்றும் i இல் வரம்பு(300000):
        s = s + "y"
        என்றால் நீளம்(s) > 32:
            s = "x"

    மாறி d = {"குறி": 0}
    ஒவ்வொன்றும் i இல் வரம்பு(50000):
        d["குறி"] = i
        மாறி t = d["குறி"]
        t += 0

    திருப்பு d["குறி"]

அச்சிடு("stress:", சோதனை())
