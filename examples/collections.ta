மாறி மாணவர்கள் = {"அருண்": 92, "கவிதா": 88, "இளம்": 95}

மாறி கூட்டல் = 0
ஒவ்வொன்றும் m இல் [92, 88, 95]:
    கூட்டல் += m

அச்சிடு("மொத்தம்:", கூட்டல்)
அச்சிடு("சராசரி:", கூட்டல் / 3)
அச்சிடு("இளம்:", மாணவர்கள்["இளம்"])

மாறி v = {"அருண்": 92, "கவிதா": 88, "இளம்": 95}
v["இளம்"] = 97
அச்சிடு("புதிய இளம்:", v["இளம்"])
